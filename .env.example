# Everything here is optional. With none of it set, the app runs in demo mode.

# Google sign in (Auth.js). Create an OAuth client in Google Cloud with the
# redirect URI http://localhost:3000/api/auth/callback/google (and your deployed
# URL). Scopes stay at openid, email and profile.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Muse Spark, for meals typed outside the library.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3

# Instacart Developer Platform. development uses connect.dev.instacart.tools.
INSTACART_API_KEY=
INSTACART_ENV=development

# SQLite file for saved households (development).
# DATABASE_PATH=data/fmp.db
