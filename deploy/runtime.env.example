# Runtime environment for meals (meals.example.com).
# Real values live on VM 110 at /opt/apps/.env.meals and in 1Password (Homelab vault).
# Never commit real secrets. With the optional keys blank, the app runs in demo mode.

PORT=3000
DATABASE_PATH=/data/fmp.db
AUTH_URL=https://meals.example.com
AUTH_TRUST_HOST=true

# Google sign in. Add https://meals.example.com/api/auth/callback/google to the OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Muse Spark, for meals typed outside the library.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3

# Instacart Developer Platform (development key until production approval).
INSTACART_API_KEY=
INSTACART_ENV=development
