# Runtime environment for meals (meals.example.com).
# Real values live on VM 110 at /opt/apps/.env.meals and in 1Password (Homelab vault).
# Never commit real secrets. With the optional keys blank, the app runs in demo mode.

PORT=3000
DATABASE_PATH=/data/fmp.db
AUTH_URL=https://meals.example.com
AUTH_TRUST_HOST=true

# Google sign in. Add https://meals.example.com/api/auth/callback/google to the OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Muse Spark, for meals typed outside the library.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_NAME=muse-spark-1.3

# Instacart Developer Platform (development key until production approval).
INSTACART_API_KEY=
INSTACART_ENV=development

# Household review emails. log records messages in the outbox table and sends nothing.
EMAIL_TRANSPORT=log
EMAIL_FROM=
# Only these addresses get real email while testing (comma separated); empty means everyone.
EMAIL_ALLOWLIST=
APP_URL=https://meals.example.com
# smtp (for example smtp.gmail.com, port 465, with a Gmail app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# or resend
RESEND_API_KEY=

# Integrations, each off unless set to 1.
FEATURE_CALENDAR=0
FEATURE_ALEXA=0
FEATURE_SKYLIGHT=0
# Calendar: seals refresh tokens at rest (32 or more random characters).
INTEGRATIONS_ENCRYPTION_KEY=
CALENDAR_NAME=Home
CALENDAR_TZ=America/Los_Angeles
# Alexa: the skill's bearer token and the household it acts on.
VOICE_API_TOKEN=
VOICE_HOUSEHOLD_EMAIL=
